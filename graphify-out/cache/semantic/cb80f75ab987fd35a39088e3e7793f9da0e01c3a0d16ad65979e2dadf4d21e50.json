{"nodes": [{"id": "thesis_main_thesis_document", "label": "MSc Thesis: Unsupervised Depth Estimation Using Intrinsic Calibration Parameters as Input", "file_type": "document", "source_file": "thesis/main.pdf", "source_location": "pages 1-109", "source_url": null, "captured_at": null, "author": "Mohammad Amin Ghasemzadeh (advisor: Dr. Behrooz Nasihatkon, K. N. Toosi University of Technology)", "contributor": null}, {"id": "thesis_main_monocular_depth_estimation", "label": "Monocular Depth Estimation", "file_type": "concept", "source_file": "thesis/main.pdf", "source_location": "abstract, ch. 2.1.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "thesis_main_metric_depth", "label": "Metric vs Non-Metric Depth", "file_type": "concept", "source_file": "thesis/main.pdf", "source_location": "ch. 2.1.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "thesis_main_scale_ambiguity", "label": "Scale Ambiguity", "file_type": "concept", "source_file": "thesis/main.pdf", "source_location": "ch. 2.1.3, fig. 1.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A small near object and a large far object can produce identical sensor images; without camera parameter information the system cannot recover true physical scale, motivating explicit intrinsics input."}, {"id": "thesis_main_camera_intrinsic_matrix", "label": "Camera Intrinsic Matrix (K)", "file_type": "concept", "source_file": "thesis/main.pdf", "source_location": "ch. 3.3.2, eq. 3.3-3.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "K = [[fx,0,cx],[0,fy,cy],[0,0,1]] encodes focal lengths and principal point; it models the 3D-to-2D projection and its parameters depend on lens focal length, sensor size and image resolution."}, {"id": "thesis_main_pinhole_camera_model", "label": "Pinhole Camera Model", "file_type": "concept", "source_file": "thesis/main.pdf", "source_location": "ch. 3.3.1, fig. 3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "thesis_main_knowledge_distillation", "label": "Teacher-Student Knowledge Distillation", "file_type": "concept", "source_file": "thesis/main.pdf", "source_location": "ch. 2.1.6, 3.7.5, fig. 2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The teacher model transfers structural knowledge and visual features to the student so the student learns physical (metric) scale while preserving structural accuracy."}, {"id": "thesis_main_self_supervised_learning", "label": "Self-Supervised Depth Learning", "file_type": "concept", "source_file": "thesis/main.pdf", "source_location": "ch. 2.1.7, 2.2.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "thesis_main_vision_transformer_concept", "label": "Vision Transformer for Depth", "file_type": "concept", "source_file": "thesis/main.pdf", "source_location": "ch. 2.1.5, 2.2.4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "thesis_main_depth_anything_v2_base_model", "label": "Depth Anything V2 Base Architecture", "file_type": "concept", "source_file": "thesis/main.pdf", "source_location": "ch. 3.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen as the base model because it is trained via distillation and has strong ability to extract semantic and geometric image features; fine-tuning adds metric depth capability and camera-information adaptation."}, {"id": "thesis_main_dinov2_backbone", "label": "DINOv2 Frozen Backbone", "file_type": "concept", "source_file": "thesis/main.pdf", "source_location": "ch. 3.7.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DINOv2 encoder is frozen during training to preserve training stability and prevent overfitting, based on the assumption that its pre-learned features are already rich enough to represent image content."}, {"id": "thesis_main_proposed_intrinsics_conditioned_model", "label": "Proposed Intrinsics-Conditioned Depth Model", "file_type": "concept", "source_file": "thesis/main.pdf", "source_location": "ch. 3.6, fig. 3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The normalized camera intrinsic matrix K is mapped by a fully-connected network into latent space and injected into the decoder as a geometric condition, deliberately separating visual information (encoder) from geometric information (K branch) to reduce sensitivity to calibration changes and increase metric consistency."}, {"id": "thesis_main_implicit_geometry_insufficiency", "label": "Insufficiency of Implicit Camera Handling", "file_type": "rationale", "source_file": "thesis/main.pdf", "source_location": "ch. 3.5.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Models that omit explicit K rely on implicit pixel relations, creating a hidden dependency on the training-set camera distribution; when faced with images from cameras with different parameters they can no longer produce accurate metric estimates, which degrades reliability in heterogeneous real-world deployments."}, {"id": "thesis_main_rmse_sensitivity", "label": "RMSE Sensitivity to Camera Parameters", "file_type": "concept", "source_file": "thesis/main.pdf", "source_location": "ch. 3.8.5, eq. 3.16, ch. 4.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RMSE depends on absolute depth values, so it reacts directly to geometric camera changes; this apparent limitation is exploited as a diagnostic tool for revealing metric instability of depth models."}, {"id": "thesis_main_metric_stability", "label": "Metric Stability Across Cameras and Datasets", "file_type": "concept", "source_file": "thesis/main.pdf", "source_location": "abstract, ch. 4.4.3, 4.5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "thesis_main_k_matrix_sensitivity_analysis", "label": "Systematic K-Matrix Sensitivity Analysis", "file_type": "concept", "source_file": "thesis/main.pdf", "source_location": "ch. 2.4.4, 4.5.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "thesis_main_vkitti_dataset", "label": "Virtual KITTI Dataset", "file_type": "concept", "source_file": "thesis/main.pdf", "source_location": "ch. 3.7.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "thesis_main_nyuv2_dataset", "label": "NYUv2 Dataset", "file_type": "concept", "source_file": "thesis/main.pdf", "source_location": "ch. 3.7.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "thesis_main_diode_dataset", "label": "DIODE Dataset", "file_type": "concept", "source_file": "thesis/main.pdf", "source_location": "ch. 3.7.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "thesis_main_cite_yang2024_depth_anything_v2", "label": "Yang et al. 2024 - Depth Anything V2", "file_type": "paper", "source_file": "thesis/main.pdf", "source_location": "bibliography [11]", "source_url": null, "captured_at": null, "author": "Lihe Yang et al.", "contributor": null}, {"id": "thesis_main_cite_hinton2015_distillation", "label": "Hinton et al. 2015 - Distilling the Knowledge in a Neural Network", "file_type": "paper", "source_file": "thesis/main.pdf", "source_location": "bibliography [12]", "source_url": null, "captured_at": null, "author": "Geoffrey Hinton, Oriol Vinyals, Jeff Dean", "contributor": null}, {"id": "thesis_main_cite_oquab2023_dinov2", "label": "Oquab et al. 2023 - DINOv2", "file_type": "paper", "source_file": "thesis/main.pdf", "source_location": "bibliography [26]", "source_url": null, "captured_at": null, "author": "Maxime Oquab et al.", "contributor": null}, {"id": "thesis_