\addvspace {10\p@ }
\contentsline {figure}{\numberline {1.1}{\ignorespaces مفهوم ابهام مقیاس (Scale Ambiguity): یک جسم کوچک در فاصلهٔ نزدیک می‌تواند دقیقاً همان تصویری را روی سنسور ایجاد کند که یک جسم بزرگ در فاصلهٔ دور ایجاد می‌کند. بدون اطلاعات اضافی از پارامترهای دوربین، سیستم قادر به تشخیص مقیاس واقعی فیزیکی نیست.}}{2}{figure.caption.8}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces تفاوت تخمین عمق متریک در مقابل غیرمتریک. خروجی مدل‌های متداول (غیرمتریک) تنها ساختار نسبی صحنه را نشان می‌دهد در حالی که یک مدل متریک دارای مقیاس فیزیکی معنادار (بر حسب متر) است. برای تولید این تصویر لطفاً خروجی مدل پایه و مدل پیشنهادی را برای یک تصویر نمونه جایگزین کنید.}}{3}{figure.caption.9}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces مفهوم کلی تقطیر دانش در تخمین عمق: مدل معلم دانش ساختاری و ویژگی‌های بصری خود را به مدل شاگرد منتقل می‌کند تا مدل شاگرد ضمن یادگیری مقیاس فیزیکی، دقت ساختاری خود را حفظ کند.}}{9}{figure.caption.10}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces دسته‌بندی کلی روش‌های تخمین عمق تک‌دوربینه در ادبیات موضوع.}}{10}{figure.caption.11}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces مدل هندسی دوربین سوراخ‌سوزنی: نگاشت یک نقطهٔ سه‌بعدی $\mathbf {X}$ به نقطهٔ دوبعدی $\mathbf {x}$ روی صفحه تصویر با توجه به فاصلهٔ کانونی $f$.}}{21}{figure.caption.12}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces معماری مدل پیشنهادی: اطلاعات تصویر توسط انکودر ازپیش‌آموزش‌دیده استخراج می‌شود. ماتریس مشخصهٔ دوربین $K$ پس از نرمال‌سازی توسط یک شبکهٔ تمام‌متصل به فضای نهان برده شده و به‌عنوان یک شرط هندسی به دیکودر تزریق می‌گردد.}}{30}{figure.caption.13}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces مقایسه عملکرد متریک (معیار SiLog) بین مدل پایه و پیشنهادی در دیتاست‌های مختلف. همان‌طور که مشاهده می‌شود مدل پیشنهادی در تمامی موارد خطای بسیار کمتری دارد.}}{54}{figure.caption.16}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces نمودار نشان‌دهنده میزان حساسیت مدل‌ها نسبت به تغییر پارامترهای کانونی دوربین. مدل پایه در مواجهه با تغییرات دارای نوسانات شدید است در حالی که مدل پیشنهادی ثبات بسیار بالاتری را نشان می‌دهد. (توجه: برای واقعی‌سازی نمودار، لطفا داده‌های حاصل از آزمون‌های خود را جایگزین مقادیر پیش‌فرض نمایید.)}}{55}{figure.caption.17}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces مقایسه کیفی نقشه‌های عمق. ستون اول: تصویر ورودی، ستون دوم: عمق مرجع، ستون سوم: خروجی مدل پایه، ستون چهارم: خروجی مدل پیشنهادی. (لطفاً شبکه‌ای از تصاویر نمونه را تولید کرده و جایگزین این تصویر نمایید.)}}{57}{figure.caption.18}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces نمای کلی از فرآیند پژوهش: حرکت از شناسایی یک محدودیت ذاتی در مدل‌های موجود تا ارائه راهکار هندسه‌آگاه و در نهایت دستیابی به پایداری متریک در تخمین عمق.}}{67}{figure.caption.19}%
